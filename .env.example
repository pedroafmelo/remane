# Copie para .env (ignorado pelo git) e preencha. NUNCA commite valores reais.
# Ajuste esta lista conforme a stack for decidida (docs/declaracao-ferramentas.md).

# Inferência (Featherless, API compatível com OpenAI): toda a inferência do produto (DEC-005)
# Pool de chaves (DEC-025): uma por pessoa, em ordem de prioridade; o cliente lê todas as FEATHERLESS_API_KEY_*.
# Cada pessoa usa só a própria chave na sua máquina; as 4 juntas só na hospedagem e em quem roda os evals.
FEATHERLESS_API_KEY_1=
FEATHERLESS_API_KEY_2=
FEATHERLESS_API_KEY_3=
FEATHERLESS_API_KEY_4=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Modelos por papel (DEC-020); nomes só valem depois do teste de fumaça. Reserva por papel: a preencher no teste.
FEATHERLESS_MODEL_SMALL=Qwen/Qwen3.5-9B
FEATHERLESS_MODEL_LARGE=google/gemma-4-31B-it
FEATHERLESS_MODEL_SMALL_FALLBACK=
FEATHERLESS_MODEL_LARGE_FALLBACK=
# Teto de unidades de concorrência do plano (conferir no painel da Featherless) e orçamento diário em US$ (guarda de custo)
FEATHERLESS_CONCURRENCY_UNITS=
FEATHERLESS_DAILY_BUDGET_USD=

# App (arquitetura.md, seção 11): botões de demo só com DEMO_MODE=1; chave de assinatura da sessão
DEMO_MODE=0
SESSION_SECRET=

# Tracing (Langfuse self-hosted, DEC-005). O SDK Python v5 lê LANGFUSE_BASE_URL (ex.: http://localhost:3000)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

