{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs_sync.py\" session-start" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs_sync.py\" stop" } ] }
    ]
  },
  "enabledMcpjsonServers": ["langfuse-docs", "docs-langchain"],
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "WebFetch(domain:langfuse.com)",
      "WebFetch(domain:docs.langchain.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:featherless.ai)",
      "WebFetch(domain:planalto.gov.br)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
